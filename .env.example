# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:jdiddles-dev-only@localhost:5432/jdiddles
# Railway private Postgres networking normally does not need this.
# For a TLS-enabled external database, use require; certificate checks stay on.
DATABASE_SSL=
# Add before allowing public registrations. These appear on the privacy page.
OPERATOR_NAME=
PRIVACY_EMAIL=
# 0 uses the socket IP. Only change after checking your trusted proxy topology.
TRUST_PROXY_HOPS=0
# Optional: a separate local database for npm test. Do not use production.
TEST_DATABASE_URL=postgresql://postgres:jdiddles-dev-only@localhost:5432/jdiddles
